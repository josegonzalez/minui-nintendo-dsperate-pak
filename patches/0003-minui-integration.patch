+// <display name>.<YYYY-MM-DD-HH-MM-SS>.png, flat in the screenshots directory
+// (paths.screenshots; the states directory unless set). The display name is
+// the ROM's filename with its extension and any trailing (...) or [...] groups
+// removed, falling back to the game code when there is no ROM. The directory
+// is made on demand, one level, so a fresh path in the config works without a
+// prior mkdir.
+std::string display_name_of(NDS& nds, const std::string& rom) {
+  std::string n = rom.empty() ? std::string() : base_name(rom_stem(rom));
+  // Trailing bracketed groups, innermost last: "Game (USA) [!]" -> "Game".
+  for (;;) {
+    while (!n.empty() && n.back() == ' ') n.pop_back();
+    if (n.size() < 2) break;
+    const char close = n.back();
+    const char open = close == ')' ? '(' : close == ']' ? '[' : '\0';
+    if (!open) break;
+    const size_t at = n.find_last_of(open);
+    if (at == std::string::npos) break;
+    n.resize(at);
+  }
+  while (!n.empty() && n.back() == ' ') n.pop_back();
+  if (!n.empty()) return n;
+  return std::string(nds.cart ? nds.cart->header().game_code : "NONE", 4);
+}
